# Copiá este archivo como .env.local y completá los valores del proyecto de Supabase.
# Están en: Supabase Dashboard > Project Settings > API
#
# Sin prefijo NEXT_PUBLIC_: las usa solo el servidor de Next (el navegador nunca
# habla con Supabase). Ver docs/seguridad.md.

SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_ANON_KEY=<clave anon del proyecto>
